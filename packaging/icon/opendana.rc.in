/* C6.42: application icon of opendana.exe (Explorer, taskbar).
 * C6.51: version resource and application manifest. */
#include <winver.h>

1 ICON "@OD_ICON_ICO@"

/* 24 = RT_MANIFEST, resource id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID */
1 24 "@OD_MANIFEST_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OpenDana\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "opendana\0"
            VALUE "LegalCopyright", "Copyright (C) The OpenDana authors. GPL-3.0-or-later.\0"
            VALUE "OriginalFilename", "opendana.exe\0"
            VALUE "ProductName", "OpenDana\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
