{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cell_tiles", "cell_palettes", "player_tiles"],
  "properties": {
    "schema_version": {"const": 1},
    "cell_tiles": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"type": "integer", "minimum": 0, "maximum": 8191}},
    "cell_palettes": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
    "player_tiles": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "integer", "minimum": 0, "maximum": 8191}}
  }
}
