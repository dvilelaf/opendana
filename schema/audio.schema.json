{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendana.local/schema/audio.schema.json",
  "title": "OpenDana sequencer stream (audio/*.json)",
  "description": "A sparse list of register writes: (bank, address, data bytes). Rebuilding the stream byte for byte gives the exact ODSEQ1 data the sequencer consumes, so the JSON is a lossless, editable view of the extracted audio (MJ2). PCM samples are out of scope (AGENTS.md L9, MJ5).",
  "type": "object",
  "required": ["schema_version", "id", "format", "writes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "format": { "const": "ODSEQ1" },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bank", "address", "data"],
        "additionalProperties": false,
        "properties": {
          "bank": { "type": "integer", "minimum": 0, "maximum": 255 },
          "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "data": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    }
  }
}
