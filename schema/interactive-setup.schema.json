{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendana.local/schema/interactive-setup.schema.json",
  "title": "EU decoded static password/editor setup (not a timeline)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "password", "editor"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "interactive-setup"},
    "password": {
      "type": "object", "additionalProperties": false,
      "required": ["chr", "palette_buffer", "field_frame", "choice_panel", "field_cursor_x", "palette_cursor_oam_yx"],
      "properties": {
        "chr": {"$ref": "#/$defs/chr"},
        "palette_buffer": {"$ref": "#/$defs/palette"},
        "field_frame": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/record"}},
        "choice_panel": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/record"}},
        "field_cursor_x": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/byte"}},
        "palette_cursor_oam_yx": {
          "type": "array", "minItems": 35, "maxItems": 35,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/byte"}},
          "description": "Raw OAM Y,X; runtime converts raw Y to screen Y exactly once."
        }
      }
    },
    "editor": {
      "type": "object", "additionalProperties": false,
      "required": ["chr", "palette_buffer", "initial_layout", "toolbar_layout", "entry_cinematic"],
      "properties": {
        "chr": {"$ref": "#/$defs/chr"},
        "palette_buffer": {"$ref": "#/$defs/palette"},
        "initial_layout": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/record"}},
        "toolbar_layout": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/record"}},
        "entry_cinematic": {"type": "integer", "minimum": 0, "maximum": 41, "description": "Semantic scene index; EU is 29. Closure must be loaded by the cinematic writer, not faked with a static frame."}
      }
    }
  },
  "$defs": {
    "byte": {"type": "integer", "minimum": 0, "maximum": 255},
    "chr": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
    "palette": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 63}, "description": "Raw palette buffer, before brightness LUT and PPU universal-color aliasing."},
    "record": {
      "type": "array", "minItems": 3, "maxItems": 3, "items": false,
      "prefixItems": [
        {"type": "integer", "anyOf": [{"minimum": 1, "maximum": 59}, {"minimum": 129, "maximum": 187}]},
        {"type": "integer", "minimum": 8192, "maximum": 10239},
        {"type": "array", "minItems": 1, "maxItems": 59, "items": {"$ref": "#/$defs/byte"}}
      ],
      "description": "[control, absolute PPU address, payload]. Parser additionally enforces payload=count&63 and destination+stride bounds. Order and duplicates are retained."
    }
  }
}
