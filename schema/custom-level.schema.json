{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendana.local/schema/custom-level.schema.json",
  "title": "OpenDana custom level (modern editor)",
  "description": "One custom level saved by the embedded editor: a package world file with a single level (schema/level.schema.json, levels with minItems 1) plus the editor's metadata block: name, author, created, modified, theme_world and editor_version. It is self-contained (the level definition is duplicated on purpose, so the schema can be validated without a resolver). Any instance is also accepted by the C validator (`opendana --validate`) and played by `opendana --play-level FILE --round 1`.",
  "type": "object",
  "required": ["schema_version", "id", "world", "grid_width", "grid_height",
               "name", "author", "created", "modified", "theme_world",
               "editor_version", "levels"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "world": { "type": "integer", "minimum": 1, "maximum": 15 },
    "grid_width": { "const": 16 },
    "grid_height": { "const": 15 },
    "name": { "type": "string", "minLength": 1, "maxLength": 63 },
    "author": { "type": "string", "maxLength": 63 },
    "created": {
      "type": "integer",
      "description": "Unix seconds."
    },
    "modified": {
      "type": "integer",
      "description": "Unix seconds."
    },
    "theme_world": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "World whose graphics the level uses."
    },
    "editor_version": { "type": "integer", "minimum": 1 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "hexRow": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "One grid row: 16 hex digits, one per cell (0x0..0xF)."
    },
    "position": {
      "type": "array",
      "description": "Cell [x, y]. The raw byte is y*16+x.",
      "items": { "type": "integer", "minimum": 0, "maximum": 15 },
      "minItems": 2,
      "maxItems": 2
    },
    "level": {
      "type": "object",
      "required": ["index", "number", "world", "round", "name", "player",
                   "metadata", "grid", "objects"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 149 },
        "number": { "type": "integer", "minimum": 1, "maximum": 150 },
        "world": { "type": "integer", "minimum": 1, "maximum": 15 },
        "round": { "type": "integer", "minimum": 1, "maximum": 10 },
        "name": { "type": "string", "minLength": 1 },
        "player": {
          "type": "object",
          "description": "Hero's start cell (exactly one Hero per level).",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 15 },
            "y": { "type": "integer", "minimum": 0, "maximum": 14 }
          }
        },
        "metadata": { "type": "integer", "minimum": 0, "maximum": 255 },
        "grid": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/hexRow" }
        },
        "objects": {
          "type": "array",
          "description": "The object record in stream order.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "positions"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "integer", "minimum": 1, "maximum": 127 },
                  "positions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 255,
                    "items": { "$ref": "#/$defs/position" }
                  }
                }
              },
              {
                "type": "object",
                "required": ["special", "argument"],
                "additionalProperties": false,
                "properties": {
                  "special": { "type": "integer", "minimum": 128, "maximum": 159 },
                  "argument": { "type": "integer", "minimum": 0, "maximum": 255 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
